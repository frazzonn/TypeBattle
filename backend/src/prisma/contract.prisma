// use prisma-8

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  createdAt     DateTime       @default(now())
  avatarUrl     String?

  // Contas antigas já contam como verificadas; o cadastro novo grava false.
  emailVerified Boolean        @default(true)
  // Conta banida pelo admin: não entra e some do ranking.
  banned        Boolean        @default(false)

  // Código de verificação enviado por email (guardado só o hash).
  verificationCodeHash  String?
  verificationExpiresAt DateTime?
  verificationSentAt    DateTime?
  verificationAttempts  Int     @default(0)

  // Resultados dos testes de digitação
  typingResults TypingResult[]

  // Partidas multiplayer (uma linha por rodada)
  battleResults BattleResult[]

  // Partidas dos jogos do Arcade (Pavio, Órbita, Perseguição, Cifra)
  arcadeResults ArcadeResult[]

  // Partidas da Cifra diária (uma por dia e modo)
  cifraPlays CifraDailyPlay[]
}
model TypingResult {
  id         Int      @id @default(autoincrement())
  userId     Int
  ppm        Int
  accuracy   Int
  errors     Int
  characters Int
  duration   Int
  // Idioma do texto; o ranking é separado por idioma
  language   String   @default("portuguese")
  // Letras em que errou e quantas vezes, em JSON (ex.: {"a":2," ":1})
  missedKeys String   @default("{}")
  // "time" (duração fixa) ou "words" (texto com wordCount palavras; a
  // duração é quanto a pessoa levou, e durationMs o tempo exato)
  mode       String   @default("time")
  wordCount  Int?
  durationMs Int?
  createdAt  DateTime @default(now())

  // Relaciona o resultado ao usuário
  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )
}

// Resultado de um jogador logado numa rodada da battle.
// Os números vêm do servidor, que calcula a pontuação da partida.
model BattleResult {
  id        Int      @id @default(autoincrement())
  userId    Int
  won       Boolean
  // Posição na rodada (1 = primeiro) e quantos jogaram
  placement Int
  players   Int
  ppm       Int
  accuracy  Int
  errors    Int
  duration  Int
  language  String
  createdAt DateTime @default(now())

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )
}

// Uma partida de um jogo do Arcade.
// score: pontos (orbita), palavras (pavio) ou milissegundos aguentados (chase).
model ArcadeResult {
  id        Int      @id @default(autoincrement())
  userId    Int
  game      String
  score     Int
  // Idioma do texto (a perseguição tem ranking por idioma)
  language  String   @default("portuguese")
  // Números extras do jogo, em JSON (onda, combo, PPM, precisão...)
  details   String   @default("{}")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([game, language])
}

// Tag criada pelo admin para destacar usuários (ex.: Dev, Adm).
model Tag {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  // Cor em hexadecimal (ex.: #a78bfa)
  color     String    @default("#a78bfa")
  // Visual da tag (classic, solid, neon, gold, terminal...)
  style     String    @default("classic")
  // Ícone opcional antes do nome (code, crown, bolt...)
  icon      String?
  createdAt DateTime  @default(now())

  users     UserTag[]
}

// Liga um usuário a uma tag; cada tag aparece uma vez por usuário.
model UserTag {
  id        Int      @id @default(autoincrement())
  userId    Int
  tagId     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([userId, tagId])
  @@index([tagId])
}

// Palavras da Cifra diária de um dia e modo (1, 2 ou 4 palavras).
// Criada quando alguém abre o dia (sorteio automático) ou quando o admin
// escolhe as palavras; depois disso não muda mais.
model CifraDaily {
  id        Int      @id @default(autoincrement())
  // Dia no horário de Brasília (ex.: "2026-11-21")
  date      String
  // Quantas palavras: 1, 2 ou 4
  boards    Int
  // Respostas sem acento, separadas por vírgula
  words     String
  // true = escolhidas pelo admin
  custom    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([date, boards])
}

// Partida de um jogador logado na Cifra diária. O tempo é medido pelo servidor.
model CifraDailyPlay {
  id         Int       @id @default(autoincrement())
  userId     Int
  date       String
  boards     Int
  // Palpites em ordem, em JSON (ex.: ["termo","cabra"])
  guesses    String    @default("[]")
  attempts   Int       @default(0)
  won        Boolean   @default(false)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, boards])
  @@index([date, boards])
}
